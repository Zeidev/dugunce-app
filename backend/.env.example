# Düğünce Backend — ortam değişkenleri
# Bu dosyayı `.env` olarak kopyalayın ve gerçek değerleri doldurun.
# .env dosyası ASLA commit edilmez (.gitignore'da).

# --- Zorunlu ---
# PostgreSQL bağlantı dizesi (serv00: pgsqlX.serv00.com)
DATABASE_URL=postgres://KULLANICI:SIFRE@pgsqlX.serv00.com:5432/VERITABANI

# JWT imzalama anahtarı — EN AZ 32 karakter, rastgele üretin
# Üretmek için: openssl rand -base64 48
JWT_SECRET=degistir-bu-anahtari-en-az-32-karakter-uzunlugunda

# development | test | production
NODE_ENV=development

# HTTP portu (serv00'da Passenger kullanır, bu değer yok sayılır)
PORT=3000

# --- Opsiyonel (ilgili aşamada zorunlu olur) ---

# Aşama 2: E-posta (magic link)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@dugunce.com.tr

# Aşama 6: Cloudflare R2 (fotoğraflar)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dugunce-photos

# Aşama 5: Web push (yardımcı bildirimleri)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@dugunce.com.tr

# --- Mobil push (FCM) — Android ---
#
# Anahtar: Firebase konsolu → Project settings → Service accounts →
# "Generate new private key" ile inen JSON dosyası. Dosyayı sunucuya
# KOYMAYIN; tek satır base64 olarak buraya yazın:
#
#   base64 -w0 service-account.json
#
# NEDEN DOSYA DEĞİL DE BASE64: serv00 paylaşımlı hosting'te dosya yolu
# yönetmek kırılgan; ayrıca .env zaten gizli ve tek yerde duruyor.
#
# GÜVENLİK: bu değer bir paroladır. Depoya girmez, log'a yazılmaz
# (logger redact listesinde).
FCM_SERVICE_ACCOUNT_BASE64=

# Push gönderimi açık/kapalı.
#
# NEDEN BAYRAK: anahtar yoksa sunucu çökmemeli. `false` iken uçlar
# çalışır (token kaydı olur) ama gönderim yapılmaz ve tek satır uyarı
# loglanır. Geliştirmede anahtar olmadan çalışabilmek için.
PUSH_ENABLED=false

# Aşama 2.5: Mağaza makbuz doğrulama
PLAY_SERVICE_ACCOUNT_JSON=
APPSTORE_KEY_ID=
APPSTORE_ISSUER_ID=
APPSTORE_PRIVATE_KEY=

# Yedekleme şifresi (scripts/backup-db.sh)
BACKUP_GPG_PASSPHRASE=

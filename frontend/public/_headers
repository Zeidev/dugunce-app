# Cloudflare Pages güvenlik başlıkları
# Ref: docs/SECURITY.md

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Davetiye sayfası: arama motoruna ve önizlemeye kapalı
/d/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Yardımcı görev uygulaması: arama motoruna ve önizlemeye kapalı
/h/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Deep link doğrulama dosyaları (Apple/Android)
/.well-known/*
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Giriş onay sayfası: token'ı işler — arama motoruna kapalı, cache'lenmez
/auth
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/auth/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Android App Links / iOS Universal Links.
#
# DİKKAT: Content-Type EKLEMEYİN. Cloudflare Pages `.json` uzantısına
# zaten `application/json` ekliyor; burada da yazmak başlığı
# `application/json, application/json` yapıyor ve Android doğrulamayı
# reddediyor (canlıda doğrulandı).
#
# Yalnızca cache süresi ayarlanır — doğrulama dosyası sık değişmez.
/.well-known/assetlinks.json
  Cache-Control: public, max-age=300

/.well-known/apple-app-site-association
  Cache-Control: public, max-age=300

# Davetiye görsel varlıkları (font, motif, fotoğraf)
#
# NOT: Dosya adları hash İÇERMİYOR. Uzun `immutable` önbellek, bozuk bir
# fontu düzeltip aynı yola koyduğumuzda kullanıcıda takılı kalır
# (Mrs Saint Delafield vakası). Bu yüzden 1 yıl değil 1 hafta + revalidate.
/assets/*
  Cache-Control: public, max-age=604800, must-revalidate

# Fontlar: yalnız .woff2 uzantısı için tip ver. OFL.txt gibi dosyalar
# bu kurala girmemeli.
/assets/fonts/*.woff2
  Content-Type: font/woff2

# Admin SPA: arama motoruna ve önizlemeye kapalı.
#
# `no-store` burada TÜM `/spa/*` yoluna uygulanır — kabuk HTML'i ve derin
# bağlantılar tazelik ister: eski bir kabuk yeni derlemenin varlık adlarını
# isteyip beyaz ekran bırakabilir. Hash'li VARLIKLAR bunun istisnasıdır,
# aşağıdaki `/spa/assets/*` bloğunda `immutable`a çevrilir.
/spa/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Hash'li varlıklar (Vite `index-abc123.js` üretir) içerik değişince adı
# da değişir — bu yüzden uzun `immutable` önbellek GÜVENLİ ve doğru.
#
# DİKKAT: `_headers` kuralları BİRLEŞİR ve aynı başlık virgülle eklenir.
# Yukarıdaki `/spa/*` bloğu `Cache-Control: no-store` yazdığı için burada
# yalnız yeni değer yazmak `no-store, public, ...` gibi ÇELİŞKİLİ bir
# başlık üretirdi. Önce `!` ile devralınanı DETACH ediyoruz.
/spa/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare Pages güvenlik başlıkları
# Ref: docs/SECURITY.md

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Davetiye sayfası: arama motoruna ve önizlemeye kapalı
/d/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Yardımcı görev uygulaması: arama motoruna ve önizlemeye kapalı
/h/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Deep link doğrulama dosyaları (Apple/Android)
/.well-known/*
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# Giriş onay sayfası: token'ı işler — arama motoruna kapalı, cache'lenmez
/auth
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/auth/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer

# Android App Links doğrulaması.
# Android bu dosyayı indirirken Content-Type'ın application/json olmasını
# şart koşar; yanlış tip → doğrulama sessizce başarısız olur.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=300

# iOS Universal Links.
# Content-Type application/json OLMAMALI (Apple imzasız dosyayı kabul eder
# ama tip json olursa bazı sürümler reddediyor).
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=300

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Rehberden kişi seçimi.

      READ_CONTACTS GEREKLİ. `ACTION_PICK` seçiciyi izinsiz açar AMA
      dönen URI'yi `contentResolver.query` ile okumak bu izni ister.
      İzin yoksa sorgu `SecurityException` fırlatır; bizim
      `runCatching` onu sessizce yutuyordu ve telefon boş kalıyordu
      ("rehberde numara var, uygulamada yok" belirtisi).

      Kullanım: yalnız kullanıcının seçtiği kişiler okunur, rehberin
      tamamı taranmaz.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Android 13+ (API 33) bildirim göstermek için ÇALIŞMA ZAMANI izni.
      İzin verilmezse uygulama çalışır, yalnız bildirim gösterilmez.
      `minSdk` 26 olduğu için kodda sürüm kontrolü yapılıyor
      (`PushNotifications.requestPermission`).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.PICK" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
    </queries>


    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="Düğünce"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dugunce">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep link — docs/DEEPLINK-SETUP.md.
              Magic link (/auth) ve düğün daveti (/invite) uygulamada açılır.
              autoVerify: assetlinks.json yayınlandığında tarayıcı atlanır;
              dosya yoksa link tarayıcıda açılmaya devam eder (zararsız).
            -->
            <!--
              Özel şema: https linki uygulamada AÇILAMAZSA (App Links
              doğrulanmamış / tarayıcıda kalmış) /auth sayfası
              `dugunce://auth?token=…` ile uygulamayı çağırır.
              Bu şema olmadan buton hiçbir şey yapmaz.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dugunce" android:host="auth" />
                <data android:scheme="dugunce" android:host="invite" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="dugunce.com.tr" android:pathPrefix="/auth" />
                <data android:scheme="https" android:host="dugunce.com.tr" android:pathPrefix="/invite" />
            </intent-filter>
        </activity>

        <!--
          Bildirim gösterimi + token yenileme.

          NEDEN GEREKLİ: FCM `notification` yükünü uygulama ARKA PLANDAYKEN
          sistem kendisi gösterir; ÖN PLANDAYKEN göstermez. Ayrıca
          bildirime dokunulduğunda doğru düğüne gitmek için `data` yükü
          işlenmeli. Bu servis ikisini de yapar.

          `exported="false"`: yalnız FCM sistemi tarafından çağrılır.
        -->
        <service
            android:name=".push.PushMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
